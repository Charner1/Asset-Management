# Secrets and local config: never commit these
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.kdbx
secrets/
config/local*
*.secret

# Real data exports and reports: never commit these
data/
exports/
reports/
*.csv
!tests/fixtures/**/*.csv
!config/*.example.csv

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# Tooling
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Editors and OS
.idea/
.vscode/
*.swp
.DS_Store
